# Copy to .env.local for local development.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev_pulse
SESSION_SECRET=change-me-to-at-least-16-chars
CRON_SECRET=change-me-shared-cron-secret
IDENTITY_SALT=epd-local-development-salt
# Optional — enables live GitHub ingestion. Without it, seeded data is used.
GITHUB_TOKEN=
# Optional demo password overrides (defaults are published in the README).
# ADMIN_PASSWORD=
# MANAGER1_PASSWORD=
# MANAGER2_PASSWORD=
