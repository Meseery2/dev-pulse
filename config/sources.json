{
  "$comment": "Squad and source-system configuration for MAL. Repos are mapped to squads here; CODEOWNERS teams provide a secondary attribution path for repos shared by several squads. Edit this file to point the dashboard at a different org — no code changes required.",
  "org": {
    "name": "MAL",
    "kAnonymityFloor": 5
  },
  "squads": [
    {
      "id": "runtime",
      "name": "Runtime",
      "description": "Server runtime and framework core.",
      "repos": ["honojs/hono", "withastro/starlight"],
      "codeownersTeams": ["@honojs/core", "@withastro/maintainers"]
    },
    {
      "id": "experience",
      "name": "Experience",
      "description": "Client libraries and data layer.",
      "repos": ["pmndrs/zustand", "TanStack/query"],
      "codeownersTeams": ["@pmndrs/zustand", "@TanStack/query"]
    },
    {
      "id": "payments",
      "name": "Payments",
      "description": "Billing and payments services. Seeded squad — demonstrates the project-management ingestion path for MAL product surfaces without a public repository equivalent.",
      "repos": ["mal/payments-api", "mal/billing-worker"],
      "codeownersTeams": []
    }
  ],
  "repos": [
    {
      "slug": "honojs/hono",
      "defaultBranch": "main",
      "provenance": "live",
      "deploySignal": {
        "kind": "workflow",
        "workflowNames": ["cr", "release"],
        "branches": ["main"]
      }
    },
    {
      "slug": "withastro/starlight",
      "defaultBranch": "main",
      "provenance": "live",
      "deploySignal": {
        "kind": "workflow",
        "workflowNames": ["Release"],
        "branches": ["main"]
      }
    },
    {
      "slug": "pmndrs/zustand",
      "defaultBranch": "main",
      "provenance": "live",
      "deploySignal": {
        "kind": "workflow",
        "workflowNames": ["Preview Release", "Build documentation and deploy to GitHub Pages"],
        "branches": ["main"]
      }
    },
    {
      "slug": "TanStack/query",
      "defaultBranch": "main",
      "provenance": "live",
      "deploySignal": {
        "kind": "workflow",
        "workflowNames": ["Release"],
        "branches": ["main"]
      }
    },
    {
      "slug": "mal/payments-api",
      "defaultBranch": "main",
      "provenance": "seeded",
      "deploySignal": { "kind": "workflow", "workflowNames": ["deploy-production"], "branches": ["main"] }
    },
    {
      "slug": "mal/billing-worker",
      "defaultBranch": "main",
      "provenance": "seeded",
      "deploySignal": { "kind": "workflow", "workflowNames": ["deploy-production"], "branches": ["main"] }
    }
  ],
  "accounts": [
    { "username": "admin", "role": "exec", "displayName": "MAL Leadership", "squadId": null },
    { "username": "manager1", "role": "squad_lead", "displayName": "Runtime Squad Lead", "squadId": "runtime" },
    { "username": "manager2", "role": "squad_lead", "displayName": "Experience Squad Lead", "squadId": "experience" }
  ]
}
